# ===== 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=crop_doctor
DB_CHARSET=utf8mb4

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== DeepSeek API =====
# 配置此 Key 后，LLM 将走 DeepSeek 云端 API；不配置则自动降级为 Mock 引擎
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== Qwen-VL API（阿里云 DashScope）=====
# 配置此 Key 后，病害识别走 Qwen-VL 云端 API；不配置则自动降级为 Mock
QWEN_API_KEY=
QWEN_VL_MODEL=qwen-vl-max

# ===== 演示模式开关 =====
# 设置为 true 后，所有 LLM 请求固定返回"玉米南方锈病完美回答"
# 这是答辩现场断网时的终极安全网
DEMO_FIXED_ANSWER=false
# 全局演示模式（Qwen-VL 和 DeepSeek 都不调用，全部走 Mock）
FORCE_DEMO_MODE=false

# ===== 模型路径（BGE-M3 / BGE-Reranker）=====
BGE_MODEL_PATH=./models/bge-m3
RERANKER_MODEL_PATH=./models/bge-reranker
# 强制 CPU，不抢占 GPU 显存，固定为 cpu
DEVICE=cpu

# ===== 文件存储 =====
UPLOAD_DIR=./uploads
FAISS_INDEX_DIR=./models/faiss_index

# ===== 服务配置 =====
BACKEND_PORT=8000
LOG_LEVEL=INFO
